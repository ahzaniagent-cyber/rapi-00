{
  "manifest_version": 3,
  "name": "SIRAPI — Isi e-Kinerja",
  "short_name": "SIRAPI",
  "version": "1.1.1",
  "description": "Isi kolom realisasi & bukti dukung e-Kinerja dari data FINAL aplikasi SIRAPI. Tanpa password, tanpa cookie, Anda yang menekan Simpan. by Ahzani Labs",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SIRAPI",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.github.io/*",
        "https://*.pages.dev/*",
        "https://*.netlify.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kinerja.bkn.go.id/*"
      ],
      "js": [
        "config.js",
        "ekinerja.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
